%% CI で erlang-pre-commit のフックを検証するためのプロジェクト
%% eqWAlizer を利用するために eqwalizer_support を依存に追加している
%% https://whatsapp.github.io/erlang-language-platform/docs/get-started/configure-project/rebar3/
{minimum_otp_vsn, "28"}.

{deps, [{eqwalizer_support,
         {git_subdir,
          "https://github.com/whatsapp/erlang-language-platform.git",
          {tag, "2026-08-10"},
          "eqwalizer/eqwalizer_support"}}]}.
